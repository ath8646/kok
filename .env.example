# 콕 환경변수 예시. 실제 값은 Vercel → Settings → Environment Variables 에만 넣어요.
# 이 파일에는 값을 적지 마세요 (공개 저장소).

# Supabase 프로젝트 주소 (공개돼도 괜찮아요)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...) (공개돼도 괜찮아요)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...) — 비밀!
SUPABASE_SECRET_KEY=
# Claude API 키 (sk-ant-...) — 비밀!
ANTHROPIC_API_KEY=
# 관리자 구글 이메일 (여러 개면 쉼표로). 구글로 로그인한 계정만 관리자가 돼요
ADMIN_EMAILS=
# 매일 청소 작업(오래된 파일 지우기 등)을 보호하는 값 — 비밀! 아무 영어·숫자 32자 이상.
# 없으면 청소가 돌지 않아요. Vercel Cron 이 이 값을 붙여 불러요.
CRON_SECRET=
# 카카오 로그인 버튼 켜기 (공개돼도 괜찮아요). 카카오 디벨로퍼스·Supabase 설정을 다 마친 뒤에 1 을 넣고 다시 배포해요.
# 비워 두면 카카오 버튼이 보이지 않아요. 빌드할 때 정해지는 값이라 바꾸면 꼭 다시 배포해요.
NEXT_PUBLIC_KAKAO_LOGIN=
# Apple 로그인 버튼 켜기 (공개돼도 괜찮아요). Apple·Supabase 설정을 다 마친 뒤에 1 을 넣고 다시 배포해요.
# 비워 두면 Apple 버튼이 보이지 않아요. 빌드할 때 정해지는 값이라 바꾸면 꼭 다시 배포해요.
NEXT_PUBLIC_APPLE_LOGIN=
